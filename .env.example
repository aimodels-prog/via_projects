# Copy to .env; never commit real secrets. Use a hex database password for URI safety.
POSTGRES_PASSWORD=replace_with_a_random_64_character_hex_password
PROJECT_ADMIN_PASSWORD=replace_with_a_strong_unique_internal_password
PROJECT_ACCESS_SECRET=replace_with_at_least_32_random_characters
# For non-Docker PostgreSQL, uncomment and configure:
# DATABASE_URL=postgresql://project_hub:password@127.0.0.1:5432/project_hub
# PROJECT_DATA_DIR=/var/lib/project-hub/reports
# DASHBOARD_TEMPLATE_FILE=/opt/project-hub/templates/raysut-dashboard.html
